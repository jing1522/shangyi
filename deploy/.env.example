# 复制成 .env 使用（.env 已被 .gitignore 忽略）
# 留空 = 不配置服务端 Key，访问者首次进入时填自己的（推荐公开演示）
DECART_API_KEY=
TOKEN_TTL=300

# —— 以下两种模式二选一 ——

# A. 本机/容器里已由 nginx 做 HTTPS：应用只跑 HTTP，绑回环地址
# HOST=127.0.0.1
# PORT=5180

# B. 应用自己扛 HTTPS（deploy-ubuntu.sh 用的就是这种）
# TLS_CERT=/opt/shanyi/certs/fullchain.pem
# TLS_KEY=/opt/shanyi/certs/privkey.pem
# HOST=0.0.0.0
# PORT=443